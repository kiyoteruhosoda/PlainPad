<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground: notepad silhouette for the adaptive icon (API 26+).

  Canvas is 108 × 108 dp; the central 72 × 72 dp (18–90 each axis) is the
  safe zone guaranteed visible across all launcher masks.

  White rounded-rectangle = the paper body.
  Brand-blue (#264AF4) lines = ruled lines; the colour matches the background
  layer so they appear as the background showing through the paper.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Paper body: white rounded rectangle, corner radius 8 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M34,20 L74,20 Q82,20 82,28 L82,82 Q82,90 74,90 L34,90 Q26,90 26,82 L26,28 Q26,20 34,20 Z" />

    <!-- Ruled lines (full width) -->
    <path
        android:fillColor="#264AF4"
        android:pathData="M35,37 L73,37 L73,42 L35,42 Z" />
    <path
        android:fillColor="#264AF4"
        android:pathData="M35,50 L73,50 L73,55 L35,55 Z" />
    <path
        android:fillColor="#264AF4"
        android:pathData="M35,63 L73,63 L73,68 L35,68 Z" />

    <!-- Last ruled line (shorter, suggests end of content) -->
    <path
        android:fillColor="#264AF4"
        android:pathData="M35,76 L57,76 L57,81 L35,81 Z" />
</vector>
