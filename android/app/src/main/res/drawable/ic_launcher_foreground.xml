<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground: notepad silhouette for the adaptive icon (API 26+).

  Canvas is 108 × 108 dp; the central 72 × 72 dp (18–90 each axis) is the
  safe zone guaranteed visible across all launcher masks.

  White rounded-rectangle = the paper body.
  Brand-blue (#264AF4) lines = ruled lines; the colour matches the background
  layer so they appear as the background showing through the paper.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Paper body: white rounded rectangle, corner radius 5 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M39,29 L69,29 Q74,29 74,34 L74,76 Q74,81 69,81 L39,81 Q34,81 34,76 L34,34 Q34,29 39,29 Z" />

    <!-- Ruled lines (full width) -->
    <path
        android:fillColor="#264AF4"
        android:pathData="M40,42 L68,42 L68,46 L40,46 Z" />
    <path
        android:fillColor="#264AF4"
        android:pathData="M40,52 L68,52 L68,56 L40,56 Z" />
    <path
        android:fillColor="#264AF4"
        android:pathData="M40,62 L68,62 L68,66 L40,66 Z" />

    <!-- Last ruled line (shorter, suggests end of content) -->
    <path
        android:fillColor="#264AF4"
        android:pathData="M40,72 L55,72 L55,76 L40,76 Z" />
</vector>
