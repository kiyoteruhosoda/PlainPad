<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground: notepad silhouette for the adaptive icon (API 26+).

  Canvas is 108 × 108 dp; the central 72 × 72 dp (18–90 each axis) is the
  safe zone guaranteed visible across all launcher masks.

  White rounded-rectangle = the paper body.
  Brand-blue (#264AF4) lines = ruled lines; the colour matches the background
  layer so they appear as the background showing through the paper.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Paper body: white rounded rectangle, corner radius 6 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M38,26 L70,26 Q76,26 76,32 L76,78 Q76,84 70,84 L38,84 Q32,84 32,78 L32,32 Q32,26 38,26 Z" />

    <!-- Ruled lines (full width) -->
    <path
        android:fillColor="#264AF4"
        android:pathData="M38,40 L70,40 L70,44 L38,44 Z" />
    <path
        android:fillColor="#264AF4"
        android:pathData="M38,51 L70,51 L70,55 L38,55 Z" />
    <path
        android:fillColor="#264AF4"
        android:pathData="M38,62 L70,62 L70,66 L38,66 Z" />

    <!-- Last ruled line (shorter, suggests end of content) -->
    <path
        android:fillColor="#264AF4"
        android:pathData="M38,73 L57,73 L57,77 L38,77 Z" />
</vector>
