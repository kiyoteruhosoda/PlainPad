<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground: notepad silhouette for the adaptive icon (API 26+).

  Canvas is 108 × 108 dp; the central 72 × 72 dp (18–90 each axis) is the
  safe zone guaranteed visible across all launcher masks.

  White rounded-rectangle = the paper body.
  Brand-blue (#264AF4) lines = ruled lines; the colour matches the background
  layer so they appear as the background showing through the paper.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Paper body: white rounded rectangle, corner radius 4 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M40,32 L68,32 Q72,32 72,36 L72,75 Q72,79 68,79 L40,79 Q36,79 36,75 L36,36 Q36,32 40,32 Z" />

    <!-- Ruled lines (full width) -->
    <path
        android:fillColor="#264AF4"
        android:pathData="M42,44 L66,44 L66,48 L42,48 Z" />
    <path
        android:fillColor="#264AF4"
        android:pathData="M42,53 L66,53 L66,57 L42,57 Z" />
    <path
        android:fillColor="#264AF4"
        android:pathData="M42,62 L66,62 L66,66 L42,66 Z" />

    <!-- Last ruled line (shorter, suggests end of content) -->
    <path
        android:fillColor="#264AF4"
        android:pathData="M42,71 L56,71 L56,75 L42,75 Z" />
</vector>
